# Environment
ENVIRONMENT=development  # development, staging, production

# Project
PROJECT_NAME=FastAPI Boilerplate

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/app_db

# JWT Authentication
# CRITICAL: Generate strong random secrets for production!
# Use: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-me-in-production
JWT_REFRESH_SECRET_KEY=your-super-secret-refresh-key-change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated list or JSON array format)
# Leave as empty array if no CORS needed, or add origins:
# Example: ["http://localhost:3000","https://yourdomain.com"]
BACKEND_CORS_ORIGINS=[]

# First Superuser (created automatically on first run)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme123
FIRST_SUPERUSER_FIRST_NAME=Admin
FIRST_SUPERUSER_LAST_NAME=User
